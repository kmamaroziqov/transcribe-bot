# Used only by the local download script. Never passed to the running containers.
HF_API_TOKEN=
# Needed only to enable the Telegram bot profile.
TELEGRAM_BOT_TOKEN=
MAX_FILE_MB=20
STT_MAX_FILE_MB=500
MAX_DURATION_SECONDS=3600
MAX_JOBS=3
ALLOWED_USER_IDS=
TELEGRAM_API_URL=

# Local host API port (container port remains 8000).
STT_PORT=18000

# Required only for the local Telegram Bot API server (my.telegram.org/apps).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
